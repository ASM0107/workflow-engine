# Database Configuration (PostgreSQL 16+)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=workflow_engine
DATABASE_USER=engine_user
DATABASE_PASSWORD=engine_password

# Complete Database Connection URL
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql://engine_user:engine_password@localhost:5432/workflow_engine

# Worker Configuration (Milestone M3+)
WORKER_POLL_INTERVAL_SECONDS=1.0
WORKER_LEASE_DURATION_SECONDS=30.0
WORKER_CONCURRENCY=4

# Server Configuration
API_HOST=0.0.0.0
API_PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO
